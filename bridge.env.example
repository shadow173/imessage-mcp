# Mac bridge configuration. Copy it into place and lock it down:
#
#   mkdir -p ~/.config/imessage-mcp
#   cp bridge.env.example ~/.config/imessage-mcp/bridge.env
#   chmod 600 ~/.config/imessage-mcp/bridge.env
#
# Format: one KEY=value per line. Spaces around the value and one pair of surrounding quotes are stripped.
# Lines starting with # are ignored. Comments must be on their own line, never after a value.
# Variables already set in the environment win over this file.
# See the Configuration section of README.md for every variable and its default.

# --- Gateway connection. Leave these commented out to run local only (the imessage CLI and Claude Code).
# GATEWAY_URL is the gateway's PUBLIC_URL, with no /mcp. Both secrets must be identical to the gateway's values
# and at least 32 characters; generate each with: openssl rand -hex 32
# GATEWAY_URL=https://<your-gateway>.example
# BRIDGE_SECRET=
# LINK_SECRET=

# --- Sending. Off for the first run: turn it on once reading works and you trust the setup.
# The code default is true. false blocks sends, scheduled sends, tapbacks, edits, typing, read receipts and
# group changes (unsend still works).
SEND_ENABLED=false
# known (anyone in Contacts; a new number needs confirmation in the conversation), all, or a comma-separated
# list of person_ids, phone numbers, emails and chat_ids. A list is the strictest choice.
SEND_ALLOWLIST=known
SEND_RATE_LIMIT_PER_HOUR=30

# --- Privacy.
# Hide one-time verification codes from the agent. false shows them (so an agent can finish a sign-in for you),
# which also lets a prompt-injected agent read them.
REDACT_CODES=true
# Comma-separated chat_ids, phone numbers, emails or Contacts names the agent must never see. Their 1:1 chats
# and every group they are in disappear from every tool.
# HIDE=

# --- Tools and time.
# Tool groups: read is always on; send, org (labels, aliases, notes, reminders), gpt (ChatGPT search/fetch),
# pa (Private API tier). Unset, it is read,send,org,gpt, plus pa when PRIVATE_API=imsg. If you set it, list pa
# yourself to use the Private API tier.
# TIERS=read,send,org,gpt
# IANA time zone. Defaults to the Mac's own; set it to match the gateway's OWNER_TZ.
# OWNER_TZ=America/Los_Angeles

# --- Optional Private API tier (off unless set). Read docs/private-api.md before enabling: it requires
# turning off System Integrity Protection and library validation.
# PRIVATE_API=imsg
# IMSG_PATH=/opt/homebrew/bin/imsg
# IMSG_AUTO_LAUNCH=false
