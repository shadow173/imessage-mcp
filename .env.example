# Gateway configuration (the public OAuth server that relays tool calls to your Mac).
#
# On Railway, set these as service variables. On any other Node host, copy this file to .env (never commit it)
# and start with: node --env-file=.env dist/gateway.js
#
# Generate each secret with: openssl rand -hex 32
# Generate the password hash with: npm run hash-password
# See the Configuration section of README.md for every variable and its default.

# Your gateway's public origin, with no trailing slash and no /mcp. The OAuth issuer and resource come from it.
PUBLIC_URL=https://<your-gateway>.example

# relay: tools run on your Mac bridge. mock: seeded fake data, for trying the gateway without a Mac.
MODE=relay

# Signs access tokens, refresh tokens and registered client ids. At least 32 characters. Keep it stable:
# rotating it signs everyone out and every connector has to be added again.
AUTH_SIGNING_SECRET=

# scrypt hash of the password you type on the sign-in page. In a .env file, wrap it in single quotes
# ('scrypt$...'): the hash contains $ characters. On Railway, paste it as is.
OWNER_PASSWORD_HASH=

# Shared with the bridge. BRIDGE_SECRET authenticates the bridge's WebSocket (at least 32 characters);
# LINK_SECRET signs file and citation links. Each must be identical in bridge.env.
BRIDGE_SECRET=
LINK_SECRET=

# Your time zone (IANA name). Set it to the same value as on the bridge.
OWNER_TZ=America/Los_Angeles

# Bump to sign out every client at once.
TOKEN_VERSION=1

# Tool groups in the fallback tool list the gateway serves before the bridge first connects after a deploy.
# Keep it the same as the bridge's TIERS (add pa only if the bridge runs with PRIVATE_API=imsg).
TIERS=read,send,org,gpt

# The port your host routes to. Most hosts set PORT themselves.
# PORT=3000
